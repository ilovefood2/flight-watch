[Unit]
Description=Flight fare scan (YYZ<->PVG, 2027)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/flight-watch
EnvironmentFile=%h/flight-watch/.env
ExecStart=/usr/bin/python3 scripts/scan.py
ExecStartPost=/usr/bin/python3 scripts/notify.py
# A scan that cannot finish in 25 min is stuck; let the next timer tick retry.
TimeoutStartSec=1500
Nice=10
# The scan only reads the network and writes state/ + alerts.json.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/flight-watch
NoNewPrivileges=true
